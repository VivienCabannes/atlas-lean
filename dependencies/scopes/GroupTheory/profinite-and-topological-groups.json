"area":null,"id":"GroupTheory/profinite-and-topological-groups/semisimple-lie-group-two-generators-dens","kind":"node","lean":"MathlibExt.GroupTheory.ScottishBook90Wanted.semisimpleLieGroup_twoGeneratorsDense","status":"can_prove","summary":"Every connected real analytic Lie group $G$ whose Lie algebra is semisimple contains two elements $a$ and $b$ such that the subgroup of $G$ generated by $a$ and $b$ is dense in $G$. In particular, for connected groups the number 4 in Problem 90 of the Scottish Book (four elements generating a dense subgroup) can be lowered to 2.","title":"Two elements generate a dense subgroup of a connected semisimple Lie group"},{"area":null,"id":"scope:GroupTheory/profinite-and-topological-groups/separability-of-isolated-subgroups","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Separability of isolated subgroups"},{"area":null,"id":"scope:GroupTheory/profinite-and-topological-groups/strong-completeness-of-profinite-groups","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Strong completeness of profinite groups"},{"area":null,"id":"scope:GroupTheory/profinite-and-topological-groups/subgroup-separability-of-baumslag-solitar-groups","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Subgroup separability of Baumslag–Solitar groups"},{"area":null,"id":"scope:GroupTheory/profinite-and-topological-groups/totally-disconnected-locally-compact-groups","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Totally disconnected locally compact groups"},{"area":null,"id":"scope:GroupTheory/profinite-and-topological-groups/upper-composition-factors-of-finitely-generated","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Upper composition factors of finitely generated groups"},{"area":null,"id":"boundary:GroupTheory","kind":"boundary","lean":null,"status":"fully_proved","summary":null,"title":"Group Theory"}],"palette":{"can_prove":{"dark":{"fill":"#