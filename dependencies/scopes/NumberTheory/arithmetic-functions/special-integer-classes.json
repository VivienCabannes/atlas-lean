{"edges":[],"nodes":[{"area":null,"id":"NumberTheory/arithmetic-functions/special-integer-classes/average-card-factors-over-h-free","kind":"node","lean":"MetaMathlibExt.average_cardFactors_over_h_free","status":"fully_proved","summary":"Let $h \\ge 2$ be an integer. Call a positive integer $n$ $h$-free if every prime occurs in the factorization of $n$ with exponent less than $h$, and write $\\Omega(n)$ for the number of prime factors of $n$ counted with multiplicity and $\\zeta$ for the Riemann zeta function. Then, as the real number $x$ tends to infinity,","title":"Average number of prime factors of h-free integers"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/benelux-pairs","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Benelux pairs"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/consecutive-smooth-numbers","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Consecutive smooth numbers"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/density-of-integers-by-their-k-th-smallest-prime","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Density of integers by their k-th smallest prime factor"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/distribution-of-cyclic-numbers","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Distribution of cyclic numbers"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/highly-composite-numbers","kind":"scope","lean":null,"status":"fully_proved","summary":null,"title":"Highly composite numbers"},{"area":null,"id":"scope:NumberTheory/arithmetic-functions/special-integer-classes/integers-with-all-prime-factors-3-mod-4","kind":"scope","lean":null,"status":"can_prove","summary":null,"title":"Integers with all prime factors 3 mod 4"},{"area":null,"id":"NumberTheory/arithmetic-f