ope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Folding lemma and paperfolding continued fractions"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/gauss-kuzmin-masses-of-continued-fraction-string","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Gauss–Kuzmin masses of continued fraction strings"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/gauss-kuzmin-wirsing-operator","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Gauss–Kuzmin–Wirsing operator"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/hata-s-farey-formula-for-euler-s-constant","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Hata's Farey formula for Euler's constant"},{"area":null,"id":"NumberTheory/continued-fractions-expansions/part-01/is-laplace-qfamily","kind":"node","lean":"MetaMathlibExt.IsLaplaceQFamily","map":true,"status":"fully_proved","summary":"Let $R$ be a semiring and let $(P_k)_{k \\ge 0}$ and $(Q_k)_{k \\ge 0}$ be sequences of polynomials in $R[X]$. The sequence $(Q_k)$ is a Laplace Q-polynomial family companion to $(P_k)$ when $Q_0 = 1$ and, for every natural number $k \\ge 1$,","title":"Laplace Q-polynomial families"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/l-roth-series","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Lüroth series"},{"area":null,"id":"NumberTheory/continued-fractions-expansions/part-01/lagrange-quadratic-convergent","kind":"node","lean":"MetaMathlibExt.lagrange_quadratic_convergent","map":true,"status":"fully_proved","summary":"Let $P, Q, R, u, y$ be integers with $P > 0$ and $y > 0$, and let $D = Q^2 - 4PR$. Assume that $D < 0$, that $D \\ne -3$, and that $P \\ne 2$ if $D = -4$. If $P u^2 + Q u y + R y^2 = 1$, then, writing $\\omega = -Q/(2P)$ with regular continued fraction expansion $\\omega = [a_0; a_1, a_2, \\dots]$, there is a natural number $n$ such that $u/y$ equals the $n$-th convergent of $\\omega$ and either $n = 0$ or the partial…","title":"Solutions of $P u^2 + Q u y + R y^2 = 1$ give convergents of $-Q/(2P)$"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/mallows-representation-of-irrational-numbers","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Mallows representation of irrational numbers"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/periodic-continued-fractions","kind":"scope","lean":null,"map":true,"status":"fully_proved","summary":null,"title":"Periodic continued fractions"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/pierce-expansions","kind":"scope","lean":null,"map":true,"status":"fully_proved","summary":null,"title":"Pierce expansions"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/polynomial-continued-fractions-and-farey-paths","kind":"scope","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Polynomial continued fractions and Farey paths"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01/trip-stern-sequences","kind":"scope","lean":null,"map":true,"status":"fully_proved","summary":null,"title":"TRIP-Stern sequences"},{"area":null,"id":"NumberTheory/continued-fractions-expansions/part-02/of-den-succ-lt-succ-succ","kind":"node","lean":"GenContFract.of_den_succ_lt_succ_succ","map":true,"status":"fully_proved","summary":"Let $K$ be a linearly ordered field with a floor function, let $v \\in K$, and write $v = [a_0; a_1, a_2, \\dots]$ for its regular continued fraction, with convergent denominators $q_0 = 1$, $q_1 = a_1$ and $q_{k+2} = a_{k+2} q_{k+1} + q_k$. For every natural number $n$, if the partial quotient $a_{n+2}$ exists (the continued fraction has not terminated before it), then $q_{n+1} < q_{n+2}$.","title":"Strict growth of continued-fraction denominators"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-01","kind":"scope","lean":null,"map":false,"status":"can_prove","summary":null,"title":"Part 1 of 2"},{"area":null,"id":"scope:NumberTheory/continued-fractions-expansions/part-02","kind":"scope","lean":null,"map":false,"status":"fully_proved","summary":null,"title":"Part 2 of 2"},{"area":null,"id":"boundary:Combinatorics","kind":"boundary","lean":null,"map":true,"status":"fully_proved","summary":null,"title":"Combinatorics"},{"area":null,"id":"boundary:Dynamics","kind":"boundary","lean":null,"map":true,"status":"fully_proved","summary":null,"title":"Dynamical Systems"},{"area":null,"id":"boundary:NumberTheory","kind":"boundary","lean":null,"map":true,"status":"can_prove","summary":null,"title":"Number Theory"}],"palette":{"can_prove":{"dark":{"fill":"#101F33","stroke":"#2D88FF"},"label":"ready to prove","light":{"fill":"#FFFFFF","stroke":"#0064E0"},"meaning":"Statement is in Lean and nothing it needs is blocked, so the proof can start."},"can_state":{"dark":{"fill":"#242526","stroke":"#2D88FF"},"label":"ready to state","light":{"fill":"#FFFFFF","stroke":"#0082FB"},"meaning":"Everything its statement uses is in Lean, so the statement can be written in Lean."},"conditional":{"dark":{"fill":"#231A36","stroke":"#9F7AEA"},"label":"conditionally proved","light":{"fill":"#E9DFFC","stroke":"#6B3FCF"},"meaning":"Proof compiles, but rests on an open statement without a recorded Lean proof."},"defined":{"dark":{"fill":"#122A1B","stroke":"#288841"},"label":"defined","light":{"fill":"#EEF8F0","stroke":"#349D4D"},"meaning":"Definition is written in Lean."},"fully_proved":{"dark":{"fill":"#13301E","stroke":"#4DD35F"},"label":"fully proved","light":{"fill":"#D7EEDD","stroke":"#1B5B2E"},"meaning":"Proved, and every prerequisite is fully proved too."},"inventory_checked":{"dark":{"fill":"#242526","stroke":"#C8CACE"},"label":"inventory checked","light":{"fill":"