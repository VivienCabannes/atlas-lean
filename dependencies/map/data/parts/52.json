parts":0,"api":[],"api_total":0,"imports_total":0,"file":"52.json"},"path":[["region:Geometry & Topology","Geometry & Topology"],["Topology","Topology"],["Topology/manifolds-geometric-topology","Manifolds and geometric topology"],["Topology/manifolds-geometric-topology/triangulation-conjecture","Triangulation conjecture"]],"children":[],"edges":[],"links":{"uses":[],"uses_total":0,"used_by":[],"used_by_total":0},"results":[{"id":"Topology/manifolds-geometric-topology/triangulation-conjecture/closed-top-manifold","title":"Closed topological manifold","status":"fully_proved","caption":"Structure","lean":"MathlibExt.Topology.ManolescuTriangulationWanted.Topology.ClosedTopManifold","summary":"For a natural number $n$, a closed topological $n$-manifold is a nonempty, compact, connected, Hausdorff, second-countable topological space $M$ together with an atlas of charts, homeomorphisms from open subsets of $M$ onto open subsets of $\\mathbb{R}^n$, whose domains cover $M$. Since the charts land in $\\mathbb{R}^n$ itself rather than in a half-space, $M$ has no boundary.","route":"../roadmap/Topology/manifolds-geometric-topology/triangulation-conjecture/index.html#closed-top-manifold"},{"id":"Topology/manifolds-geometric-topology/triangulation-conjecture/triangulable","title":"Triangulable closed manifold","status":"fully_proved","caption":"Definition","lean":"MathlibExt.Topology.ManolescuTriangulationWanted.Topology.Triangulable","summary":"A closed topological $n$-manifold $M$ is triangulable if, for some natural number $N$, there is a simplicial complex $K$ in $\\mathbb{R}^N$ with finitely many faces such that $M$ is homeomorphic to the geometric realization of $K$, the union of its faces with the subspace topology from $\\mathbb{R}^N$.","route":"../roadmap/Topology/manifolds-geometric-topology/triangulation-conjecture/index.html#triangulable"},{"id":"Topology/manifolds-geometric-topology/triangulation-conjecture/manolescu-triangulation-disproof","title":"Manolescu's disproof of the triangulation conjecture","status":"can_prove","caption":"Theorem","lean":"MathlibExt.Topology.ManolescuTriangulationWanted.Topology.manolescu_triangulation_disproof","summary":"For every natural number $n \\ge 5$ there is a closed connected topological $n$-manifold that is not triangulable.","route":"../roadmap/Topology/manifolds-geometric-topology/triangulation-conjecture/index.html#manolescu-triangulation-disproof"}],"result_edges":[["Topology/manifolds-geometric-topology/triangulation-conjecture/manolescu-triangulation-disproof","Topology/manifolds-geometric-topology/triangulation-conjecture/closed-top-manifold",1,0],["Topology/manifolds-geometric-topology/triangulation-conjecture/triangulable","Topology/manifolds-geometric-topology/triangulation-conjecture/closed-top-manifold",1,0],["Topology/manifolds-geometric-topology/triangulation-conjecture/manolescu-triangulation-disproof","Topology/manifolds-geometric-topology/triangulation-conjecture/triangulable",1,0]],"boundary_edges":[],"outside":[]},"Combinatorics/partially-ordered-sets":{"part":{"id":"Combinatorics/partially-ordered-sets","title":"Partially ordered sets","results":95,"status":{"can_prove":10,"fully_proved":85},"parts":11,"api":[],"api_total":0,"imports_total":1,"file":"52.json"},"path":[["region:Discrete Mathematics & Computer Science","Discrete Mathematics & Computer Science"],["Combinatorics","Combinatorics"],["Combinatorics/partially-ordered-sets","Partially ordered sets"]],"children":[{"id":"Combinatorics/partially-ordered-sets/chain-polynomials-of-posets","title":"Chain polynomials of posets","results":3,"status":{"can_prove":1,"fully_proved":2},"parts":0,"api":[],"api_total":0,"imports_total":1,"file":"37.json"},{"id":"Combinatorics/partially-ordered-sets/dilworth-s-theorem","title":"Dilworth's theorem","results":8,"status":{"fully_proved":8},"parts":0,"api":[],"api_total":0,"imports_total":0,"file":"c1.json"},{"id":"Combinatorics/partially-ordered-sets/erd-s-szekeres-theorem","tit